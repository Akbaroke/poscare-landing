---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Plus from '@lucide/astro/icons/plus';
import { isExternal, PRODUCTS, STATUS_LABEL, type Product } from '../../data/products';
import { SPACARE_PRICING, whatsapp } from '../../data/site';
import ProductIcon from '../ProductIcon.astro';
import ProductWordmark from '../ProductWordmark.astro';

const STRIPE = {
  spa: 'bg-spa',
  laundry: 'bg-laundry',
  sport: 'bg-sport',
  retail: 'bg-retail',
};
const HOVER_BORDER = {
  spa: 'hover:border-spa',
  laundry: 'hover:border-laundry',
  sport: 'hover:border-sport',
  retail: 'hover:border-retail',
};
/** Look of a live product's card: its own identity colours. */
const LIVE_TONE: Partial<
  Record<Product['id'], { card: string; text: string; badge: string; cta: string; line: string }>
> = {
  spa: {
    card: 'border-spa/30 bg-spa-soft/40 hover:border-spa',
    text: 'text-spa',
    badge: 'bg-spa text-white',
    cta: 'bg-spa-app',
    line: 'border-spa/20',
  },
  sport: {
    card: 'border-sport/25 bg-sport-soft/50 hover:border-sport',
    text: 'text-sport',
    badge: 'bg-sport-app text-white',
    cta: 'bg-sport-navy',
    line: 'border-sport/20',
  },
};
const NEUTRAL_TONE = {
  card: 'border-border-strong bg-surface hover:border-navy',
  text: 'text-ink',
  badge: 'bg-navy text-white',
  cta: 'bg-navy',
  line: 'border-border',
};
/** Short offer line under a live product; only facts that are fixed. */
const OFFER: Partial<Record<Product['id'], string>> = {
  spa: `Mulai ${SPACARE_PRICING.fromMonthly}/bulan · Coba gratis ${SPACARE_PRICING.trialDays} hari`,
  sport: 'Coba gratis untuk venue baru · Paket di sport.poscare.id',
};

const live = PRODUCTS.filter((p) => p.status === 'available');
const upcoming = PRODUCTS.filter((p) => p.status !== 'available');
const host = (href: string) => href.replace(/^https?:\/\//, '');
---

<section id="solusi" class="border-y border-border bg-surface">
  <div class="container-page section">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Solusi PosCare</p>
        <h2 class="h2 mt-3">Satu platform. Solusi yang dibuat sesuai bisnis Anda.</h2>
      </div>
      <p class="lead max-w-md lg:text-right">
        Pilih sesuai jenis usaha. Semuanya dibangun di atas fondasi PosCare.
      </p>
    </div>

    <!-- Products you can use today -->
    <ul class:list={['mt-10 grid gap-4 lg:mt-14', live.length > 1 && 'md:grid-cols-2']}>
      {live.map((p) => {
        const tone = LIVE_TONE[p.id] ?? NEUTRAL_TONE;
        return (
          <li>
            <a
              href={p.href}
              {...(isExternal(p.href) ? { rel: 'noopener' } : {})}
              class:list={[
                'group relative flex h-full flex-col overflow-hidden rounded-lg border-2 p-6 transition-colors sm:p-8',
                tone.card,
              ]}
            >
              <span
                class:list={['absolute inset-x-0 top-0 h-1', STRIPE[p.id]]}
                aria-hidden="true"
              />
              <div class="flex items-start justify-between gap-4">
                <ProductIcon id={p.id} size="lg" />
                <span class:list={['badge', tone.badge]}>
                  <span class="size-1.5 rounded-full bg-white" aria-hidden="true" />
                  {STATUS_LABEL[p.status]}
                </span>
              </div>
              <h3 class="mt-6">
                <ProductWordmark id={p.id} name={p.name} height={32} />
              </h3>
              <p class:list={['mt-1 text-sm font-semibold', tone.text]}>{p.industry}</p>
              <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.summary}</p>
              {p.audience && <p class="mt-4 text-sm font-medium text-ink">{p.audience}</p>}
              {OFFER[p.id] && (
                <p class:list={['mt-6 border-t pt-4 text-sm font-medium text-ink', tone.line]}>
                  {OFFER[p.id]}
                </p>
              )}
              <div class="mt-8 flex flex-1 items-end">
                <span
                  class:list={[
                    'inline-flex min-h-12 w-full items-center justify-between rounded-md px-5 font-semibold text-white transition-colors group-hover:bg-navy',
                    tone.cta,
                  ]}
                >
                  {p.cta}
                  <ArrowUpRight size={18} aria-hidden="true" />
                </span>
              </div>
              <p class="mt-3 text-center text-xs text-muted">{host(p.href)}</p>
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Coming soon, plus an open invitation -->
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.map((p) => (
        <li>
          <a
            href={p.href}
            {...(isExternal(p.href) ? { rel: 'noopener' } : {})}
            class:list={[
              'group relative flex h-full flex-col overflow-hidden rounded-lg border border-border bg-surface p-6 shadow-xs transition-colors',
              HOVER_BORDER[p.id],
            ]}
          >
            <span
              class:list={['absolute inset-x-0 top-0 h-1 opacity-70', STRIPE[p.id]]}
              aria-hidden="true"
            />
            <div class="flex items-start justify-between gap-4">
              <ProductIcon id={p.id} />
              <span class="badge bg-sunken text-muted">{STATUS_LABEL[p.status]}</span>
            </div>
            <h3 class="mt-5">
              <ProductWordmark id={p.id} name={p.name} height={26} />
            </h3>
            <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{p.summary}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-semibold text-ink">
              {p.cta}
              <ArrowRight
                size={16}
                class="transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
          </a>
        </li>
      ))}

      <li>
        <a
          href={whatsapp('Halo PosCare, saya punya usaha di bidang: \nCara kerja bisnis saya: ')}
          class="group flex h-full flex-col rounded-lg border border-dashed border-border-strong p-6 transition-colors hover:border-navy"
        >
          <span class="flex size-11 items-center justify-center rounded-md border border-dashed border-border-strong text-muted">
            <Plus size={22} stroke-width={1.75} aria-hidden="true" />
          </span>
          <h3 class="mt-5 text-xl font-bold tracking-tight">Bisnis Anda belum ada di sini?</h3>
          <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">
            Ceritakan cara kerja bisnis Anda. Solusi berikutnya kami bangun dari kebutuhan nyata.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-semibold">
            Ceritakan ke kami
            <ArrowRight
              size={16}
              class="transition-transform group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </span>
        </a>
      </li>
    </ul>

    <p class="mt-6 text-sm text-muted">
      Setiap solusi: <span class="font-semibold text-ink">Powered by PosCare</span>. Saat ini yang
      sudah bisa dipakai adalah {live.map((p) => p.name).join(' dan ')}; solusi lain segera hadir,
      klik untuk dikabari saat siap.
    </p>
  </div>
</section>
