---
import BarChart3 from '@lucide/astro/icons/chart-column';
import Info from '@lucide/astro/icons/info';
import Package from '@lucide/astro/icons/package';
import QrCode from '@lucide/astro/icons/qr-code';
import ReceiptText from '@lucide/astro/icons/receipt-text';
import Users from '@lucide/astro/icons/users';

const STEPS = [
  { icon: Users, title: 'Pelanggan', body: 'Data dan riwayat pelanggan tersimpan rapi.' },
  {
    icon: Package,
    title: 'Produk / layanan',
    body: 'Pilih dari daftar dengan harga yang sudah diatur.',
  },
  {
    icon: ReceiptText,
    title: 'Transaksi',
    body: 'Kasir menghitung total, diskon, dan biaya tambahan.',
  },
  { icon: QrCode, title: 'Pembayaran', body: 'Bayar cash atau QRIS, statusnya langsung tercatat.' },
  {
    icon: BarChart3,
    title: 'Laporan',
    body: 'Pendapatan dan transaksi masuk ke laporan otomatis.',
  },
];

const PAYMENT_FLOW = [
  'Checkout',
  'QRIS tampil',
  'Pelanggan membayar',
  'Status diperbarui',
  'Tercatat di laporan',
];
---

<section id="cara-kerja" class="border-y border-border bg-surface">
  <div class="container-page section">
    <div class="max-w-2xl">
      <p class="eyebrow">Cara kerja</p>
      <h2 class="h2 mt-3">Dari pelanggan datang sampai laporan, satu alur.</h2>
      <p class="lead mt-4">
        Fondasinya sama di setiap solusi PosCare. Langkah di antaranya menyesuaikan industri.
      </p>
    </div>

    <ol class="relative mt-10 grid gap-0 lg:mt-14 lg:grid-cols-5 lg:gap-4">
      <!-- Connector line behind the step markers (vertical on mobile, horizontal on desktop). -->
      <span
        class="absolute top-5 bottom-5 left-5 w-0.5 bg-linear-to-b from-orange-from to-orange-to lg:top-5 lg:right-[10%] lg:bottom-auto lg:left-[10%] lg:h-0.5 lg:w-auto lg:bg-linear-to-r"
        aria-hidden="true"
      ></span>
      {STEPS.map(({ icon: Icon, title, body }, i) => (
        <li class="relative flex gap-4 pb-8 last:pb-0 lg:flex-col lg:items-center lg:pb-0 lg:text-center">
          <span class="relative flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-orange bg-surface text-ink">
            <Icon size={18} stroke-width={2} aria-hidden="true" />
          </span>
          <div class="pt-1.5 lg:pt-0">
            <p class="text-xs font-semibold text-subtle">Langkah {i + 1}</p>
            <h3 class="mt-0.5 text-lg font-bold">{title}</h3>
            <p class="mt-1 text-[15px] leading-relaxed text-muted">{body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-14 rounded-lg border border-border bg-bg p-5 sm:p-7">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h3 class="text-lg font-bold">Transaksi dan pembayaran dalam satu alur</h3>
        <p class="text-sm text-muted">Tidak perlu mencocokkan mutasi satu per satu.</p>
      </div>
      <ol class="mt-5 flex flex-wrap items-center gap-2">
        {PAYMENT_FLOW.map((step, i) => (
          <li class="flex items-center gap-2">
            <span class="inline-flex min-h-9 items-center gap-2 rounded-md border border-border bg-surface px-3 text-sm font-semibold">
              <span class="text-xs text-subtle tabular-nums">{i + 1}</span>
              {step}
            </span>
            {i < PAYMENT_FLOW.length - 1 && (
              <span class="text-subtle" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-5 flex gap-2 text-[13px] leading-relaxed text-muted">
        <Info size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
        Pembayaran QRIS diproses melalui mitra penyedia jasa pembayaran. PosCare adalah software
        operasional bisnis, bukan bank atau payment gateway.
      </p>
    </div>
  </div>
</section>
