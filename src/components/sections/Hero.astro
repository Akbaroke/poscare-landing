---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PlatformDiagram from '../PlatformDiagram.astro';

const POINTS = ['Mobile-first', 'Pembayaran QRIS terintegrasi', 'Dibuat untuk UMKM Indonesia'];
---

<section id="top" class="container-page pt-10 pb-16 sm:pt-16 lg:pt-20 lg:pb-24">
  <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
    <div>
      <p class="eyebrow">Business Operations Platform</p>
      <h1 class="mt-4 text-[40px] leading-[1.05] font-extrabold tracking-tight text-balance sm:text-[56px] lg:text-[64px]">
        Operasional bisnis, dibuat lebih sederhana.
      </h1>
      <p class="lead mt-5 max-w-xl">
        PosCare menghadirkan solusi bisnis yang dirancang sesuai kebutuhan setiap industri — dari
        pelanggan, transaksi, pembayaran, hingga laporan.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#solusi" class="btn-primary">
          Temukan solusi untuk bisnis Anda
          <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a href="#pendekatan" class="btn-secondary">
          Kenali PosCare
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        {POINTS.map((point) => (
          <li class="inline-flex items-center gap-2">
            <span class="size-1 rounded-full bg-subtle" aria-hidden="true" />
            {point}
          </li>
        ))}
      </ul>
    </div>

    <PlatformDiagram />
  </div>
</section>
