---
import Phone from './Phone.astro';

const { class: className } = Astro.props as { class?: string };

const SOAP = [
  ['S', 'Subjective', 'Rewel saat tidur malam, kata ibu.'],
  ['O', 'Objective', 'BB 7,8 kg. Kulit normal, aktif.'],
  ['A', 'Assessment', 'Cocok untuk pijat relaksasi.'],
  ['P', 'Plan', 'Baby massage + swim. Kembali 2 minggu.'],
];
---

<Phone
  class={className}
  title="Catatan treatment"
  label="Ilustrasi layar SpaCare: catatan treatment dengan format SOAP untuk pelanggan anak."
>
  <div class="rounded-lg border border-[#e5e7eb] bg-white p-3">
    <div class="flex items-center gap-2.5">
      <span class="flex size-9 items-center justify-center rounded-full bg-[#ddefe5] text-[12px] font-bold text-[#12372a]">
        AL
      </span>
      <div>
        <p class="text-[13px] font-bold">Alya</p>
        <p class="text-[11px] text-[#6b7280]">Anak · 8 bulan · Ibu Rina</p>
      </div>
    </div>
    <div class="mt-2.5 flex gap-1.5 text-[10px] font-bold">
      <span class="rounded-[4px] bg-[#ddefe5] px-1.5 py-0.5 text-[#12372a]">Baby massage</span>
      <span class="rounded-[4px] bg-[#ddefe5] px-1.5 py-0.5 text-[#12372a]">Baby swim</span>
    </div>
  </div>
  {SOAP.map(([letter, name, text]) => (
    <div class="rounded-lg border border-[#e5e7eb] bg-white p-2.5">
      <div class="flex items-center gap-2">
        <span class="flex size-5 items-center justify-center rounded-[4px] bg-[#12372a] text-[10px] font-bold text-white">
          {letter}
        </span>
        <p class="text-[11px] font-bold text-[#6b7280]">{name}</p>
      </div>
      <p class="mt-1.5 text-[12px] leading-snug">{text}</p>
    </div>
  ))}
  <div class="rounded-[6px] bg-[#12372a] py-2.5 text-center text-[12px] font-bold text-white">
    Simpan catatan
  </div>
</Phone>
