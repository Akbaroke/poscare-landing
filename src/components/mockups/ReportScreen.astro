---
import Phone from './Phone.astro';

const { class: className } = Astro.props as { class?: string };

const BARS = [42, 58, 35, 70, 64, 88, 76];
const DAYS = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
const TOP = [
  ['Baby massage', '38x'],
  ['Mom massage', '21x'],
  ['Baby swim', '17x'],
];
---

<Phone
  class={className}
  title="Laporan"
  label="Ilustrasi layar SpaCare: laporan pendapatan mingguan dengan grafik dan layanan terlaris."
>
  <div class="flex gap-1 rounded-[6px] bg-white p-1 text-center text-[11px] font-bold">
    <span class="flex-1 rounded-[4px] py-1 text-[#6b7280]">Hari ini</span>
    <span class="flex-1 rounded-[4px] bg-[#12372a] py-1 text-white">Minggu ini</span>
    <span class="flex-1 rounded-[4px] py-1 text-[#6b7280]">Bulan ini</span>
  </div>
  <div class="rounded-lg border border-[#e5e7eb] bg-white p-3">
    <p class="text-[11px] text-[#6b7280]">Pendapatan</p>
    <p class="text-[20px] font-bold tabular-nums text-[#12372a]">Rp4.860.000</p>
    <p class="text-[11px] text-[#6b7280]">32 transaksi</p>
    <div class="mt-3 flex h-24 items-end gap-1.5">
      {BARS.map((h, i) => (
        <div class="flex flex-1 flex-col items-center gap-1">
          <div
            class:list={['w-full rounded-t-[3px]', i === 5 ? 'bg-[#12372a]' : 'bg-[#ddefe5]']}
            style={`height:${h}px`}
          />
          <span class="text-[9px] text-[#6b7280]">{DAYS[i]}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="grid grid-cols-2 gap-2">
    <div class="rounded-lg border border-[#e5e7eb] bg-white p-2.5">
      <p class="text-[10px] text-[#6b7280]">Cash</p>
      <p class="text-[13px] font-bold tabular-nums">Rp1.940.000</p>
    </div>
    <div class="rounded-lg border border-[#e5e7eb] bg-white p-2.5">
      <p class="text-[10px] text-[#6b7280]">QRIS</p>
      <p class="text-[13px] font-bold tabular-nums">Rp2.920.000</p>
    </div>
  </div>
  <div class="rounded-lg border border-[#e5e7eb] bg-white p-3">
    <p class="text-[11px] font-bold text-[#6b7280]">Layanan terlaris</p>
    {TOP.map(([name, count]) => (
      <div class="mt-1.5 flex justify-between text-[12px]">
        <span>{name}</span>
        <span class="tabular-nums text-[#6b7280]">{count}</span>
      </div>
    ))}
  </div>
</Phone>
