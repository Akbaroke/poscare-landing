---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import { SPACARE_LOGIN_URL, SPORTCARE_LOGIN_URL } from '../data/site';
import Logo from './Logo.astro';

const LINKS = [
  { href: '/#solusi', label: 'Solusi' },
  { href: '/#cara-kerja', label: 'Cara kerja' },
  { href: '/#spacare', label: 'SpaCare' },
  { href: '/#sportcare', label: 'SportCare' },
  { href: '/#tentang', label: 'Tentang' },
  { href: '/#faq', label: 'FAQ' },
];

// Each product has its own account; "Masuk" asks which one.
const LOGINS = [
  { href: SPACARE_LOGIN_URL, label: 'Masuk ke SpaCare' },
  { href: SPORTCARE_LOGIN_URL, label: 'Masuk ke SportCare' },
];
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-bg">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Utama">
    <a href="/" class="-m-1 p-1" aria-label="PosCare, ke beranda">
      <Logo />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-[15px] font-medium text-muted transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-2 lg:flex">
      <details class="group/login relative" data-login-menu>
        <summary class="btn-ghost min-h-10 cursor-pointer list-none text-[15px] [&::-webkit-details-marker]:hidden">
          Masuk
          <ChevronDown
            size={16}
            class="text-subtle transition-transform group-open/login:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <ul class="absolute right-0 mt-2 w-56 rounded-lg border border-border bg-surface p-1.5 shadow-sm">
          {LOGINS.map((l) => (
            <li>
              <a
                href={l.href}
                rel="noopener"
                class="flex min-h-11 items-center justify-between rounded-md px-3 text-[15px] font-medium hover:bg-sunken"
              >
                {l.label}
                <ArrowUpRight size={16} class="text-subtle" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a href="/#solusi" class="btn-primary min-h-10">
        Lihat solusi
      </a>
    </div>

    <details class="group lg:hidden" data-mobile-menu>
      <summary
        class="-mr-2 flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-ink hover:bg-sunken [&::-webkit-details-marker]:hidden"
        aria-label="Buka menu"
      >
        <Menu size={22} class="group-open:hidden" aria-hidden="true" />
        <X size={22} class="hidden group-open:block" aria-hidden="true" />
      </summary>
      <div
        class="absolute inset-x-0 top-16 border-b border-border bg-surface shadow-sm"
        data-mobile-panel
      >
        <ul class="container-page flex flex-col py-2">
          {LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-12 items-center border-b border-border text-base font-medium"
              >
                {link.label}
              </a>
            </li>
          ))}
          {LOGINS.map((l, i) => (
            <li>
              <a
                href={l.href}
                rel="noopener"
                class:list={[
                  'flex min-h-12 items-center justify-between text-base font-medium',
                  i < LOGINS.length - 1 && 'border-b border-border',
                ]}
              >
                {l.label}
                <ArrowUpRight size={18} class="text-subtle" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
        <div class="container-page pt-1 pb-4">
          <a href="/#solusi" class="btn-primary w-full">
            Lihat solusi
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link, and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu
    ?.querySelectorAll('a')
    .forEach((a) => a.addEventListener('click', () => (menu.open = false)));
  // Desktop "Masuk" dropdown: close on Escape or a click outside it.
  const login = document.querySelector<HTMLDetailsElement>('[data-login-menu]');
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu?.open) menu.open = false;
    if (login?.open) login.open = false;
  });
  document.addEventListener('click', (e) => {
    if (login?.open && !login.contains(e.target as Node)) login.open = false;
  });
</script>
