---
import logo from '../assets/brand/poscare-logo.png';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<img
  src={logo.src}
  width={Math.round((logo.width / logo.height) * 36)}
  height="36"
  alt="PosCare"
  draggable="false"
  class:list={['block h-9 w-auto select-none', className]}
/>
