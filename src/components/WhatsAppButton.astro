---
import MessageCircle from '@lucide/astro/icons/message-circle';
import { whatsapp } from '../data/site';
---

<a
  href={whatsapp('Halo PosCare, saya ingin bertanya: ')}
  rel="noopener"
  aria-label="Chat PosCare di WhatsApp"
  class="fixed right-4 bottom-[calc(16px+env(safe-area-inset-bottom))] z-30 inline-flex min-h-12 items-center gap-2 rounded-full bg-navy px-4 text-[15px] font-semibold text-white shadow-sm transition-colors hover:bg-navy-700 sm:right-6 sm:bottom-6"
>
  <MessageCircle size={20} aria-hidden="true" />
  <span>WhatsApp</span>
</a>
