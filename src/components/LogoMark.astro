---
import mark from '../assets/brand/poscare-mark.png';

/** The PosCare "P" symbol alone. Decorative: always sits next to the PosCare name. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<img
  src={mark.src}
  width={mark.width}
  height={mark.height}
  alt=""
  aria-hidden="true"
  draggable="false"
  class:list={['object-contain select-none', className]}
/>
