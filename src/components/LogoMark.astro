---
/**
 * Placeholder PosCare mark (a modern "P" in the orange gradient), drawn from the brand brief.
 * Swap for the official logo file when it is available.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = `pc-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="4" y1="4" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#FF8A1F"></stop>
      <stop offset="1" stop-color="#F0482A"></stop>
    </linearGradient>
  </defs>
  <path
    d="M9.5 27.5V11.5a6 6 0 0 1 6-6h1.5a7.25 7.25 0 0 1 0 14.5h-3"
    fill="none"
    stroke={`url(#${id})`}
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
