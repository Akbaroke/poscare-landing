---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Halaman tidak ditemukan" noindex>
  <Navbar />
  <main id="main" class="container-page py-24 text-center sm:py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Halaman tidak ditemukan</h1>
    <p class="lead mx-auto mt-4 max-w-md">
      Alamatnya mungkin salah atau halamannya sudah dipindah.
    </p>
    <a href="/" class="btn-primary mt-8">
      Kembali ke beranda
    </a>
  </main>
  <Footer />
</Base>
