---
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import FileText from '@lucide/astro/icons/file-text';
import Mail from '@lucide/astro/icons/mail';
import MessageCircle from '@lucide/astro/icons/message-circle';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { LEGAL_EFFECTIVE_DATE, type LegalSection } from '../data/legal';
import { SITE, whatsapp } from '../data/site';
import Base from './Base.astro';

interface Props {
  kind: 'privacy' | 'terms';
  title: string;
  description: string;
  intro: string;
  summary: string[];
  sections: LegalSection[];
}
const { kind, title, description, intro, summary, sections } = Astro.props;

const effective = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
}).format(new Date(`${LEGAL_EFFECTIVE_DATE}T00:00:00+07:00`));

const DOCS = [
  { kind: 'privacy', href: '/privasi', label: 'Kebijakan Privasi', icon: ShieldCheck },
  { kind: 'terms', href: '/syarat', label: 'Syarat & Ketentuan', icon: FileText },
] as const;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title={title} description={description}>
  <Navbar />
  <main id="main">
    <!-- Header band -->
    <header class="border-b border-border bg-surface">
      <div class="container-page pt-10 pb-0 sm:pt-14">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <ol class="flex items-center gap-2">
            <li>
              <a href="/" class="hover:text-ink">
                Beranda
              </a>
            </li>
            <li aria-hidden="true" class="text-subtle">
              /
            </li>
            <li>Legal</li>
            <li aria-hidden="true" class="text-subtle">
              /
            </li>
            <li aria-current="page" class="font-medium text-ink">
              {title}
            </li>
          </ol>
        </nav>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
        <div class="legal-prose mt-4 max-w-2xl" set:html={intro} />
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
          <div>
            <dt class="text-subtle">Berlaku sejak</dt>
            <dd class="mt-0.5 font-semibold">
              <time datetime={LEGAL_EFFECTIVE_DATE}>{effective}</time>
            </dd>
          </div>
          <div>
            <dt class="text-subtle">Dikelola oleh</dt>
            <dd class="mt-0.5 font-semibold">{SITE.company}</dd>
          </div>
          <div>
            <dt class="text-subtle">Berlaku untuk</dt>
            <dd class="mt-0.5 font-semibold">poscare.id dan produk PosCare</dd>
          </div>
        </dl>

        <!-- Switch between the two documents -->
        <nav aria-label="Dokumen legal" class="mt-8 -mb-px flex gap-6">
          {DOCS.map(({ kind: k, href, label, icon: Icon }) => (
            <a
              href={href}
              aria-current={k === kind ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-12 items-center gap-2 border-b-2 text-[15px] font-semibold transition-colors',
                k === kind
                  ? 'border-orange text-ink'
                  : 'border-transparent text-muted hover:text-ink',
              ]}
            >
              <Icon size={18} aria-hidden="true" />
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <div class="container-page grid gap-10 py-10 sm:py-14 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-16">
      <!-- Table of contents: collapsible on mobile, sticky with the active section on desktop -->
      <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto">
        <details class="group card lg:hidden">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between px-4 text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
            Daftar isi
            <ChevronDown
              size={20}
              class="text-subtle transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <ol class="border-t border-border px-4 py-2">
            {sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="flex min-h-10 items-center gap-3 text-[15px] text-muted"
                >
                  <span class="w-5 text-xs text-subtle tabular-nums">{num(i)}</span>
                  {s.title}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <nav aria-labelledby="toc-title" class="hidden lg:block">
          <p id="toc-title" class="text-xs font-semibold tracking-wide text-subtle">
            DI HALAMAN INI
          </p>
          <ol class="mt-4 border-l border-border" data-toc>
            {sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-toc-link={s.id}
                  class="-ml-px flex gap-3 border-l-2 border-transparent py-1.5 pl-4 text-sm leading-snug text-muted transition-colors hover:text-ink data-[active]:border-orange data-[active]:font-semibold data-[active]:text-ink"
                >
                  <span class="w-5 shrink-0 text-xs leading-5 text-subtle tabular-nums">
                    {num(i)}
                  </span>
                  {s.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <div class="min-w-0 max-w-3xl">
        <!-- Plain-language summary -->
        <section
          aria-labelledby="ringkasan-title"
          class="rounded-lg border border-border bg-surface p-5 sm:p-6"
        >
          <h2 id="ringkasan-title" class="text-base font-bold">
            Ringkasnya
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {summary.map((point) => (
              <li class="flex gap-3 text-[15px] leading-relaxed">
                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-orange-soft text-orange-ink">
                  <Check size={13} stroke-width={3} aria-hidden="true" />
                </span>
                {point}
              </li>
            ))}
          </ul>
          <p class="mt-4 border-t border-border pt-3 text-[13px] text-muted">
            Ringkasan ini untuk memudahkan. Yang berlaku adalah isi lengkap di bawah.
          </p>
        </section>

        <div class="mt-4">
          {sections.map((s, i) => (
            <section
              id={s.id}
              aria-labelledby={`${s.id}-title`}
              class="scroll-mt-24 border-b border-border py-9 last:border-b-0"
              data-legal-section
            >
              <p class="text-sm font-semibold text-orange-ink tabular-nums">{num(i)}</p>
              <h2 id={`${s.id}-title`} class="mt-1 text-2xl font-bold tracking-tight">
                {s.title}
              </h2>
              <div class="legal-prose mt-4" set:html={s.html} />
            </section>
          ))}
        </div>

        <!-- Contact -->
        <section
          aria-labelledby="kontak-legal-title"
          class="mt-6 rounded-lg bg-navy p-6 text-white sm:p-8"
        >
          <h2 id="kontak-legal-title" class="text-xl font-bold">
            Ada pertanyaan tentang dokumen ini?
          </h2>
          <p class="mt-2 text-[15px] leading-relaxed text-white/75">
            Hubungi kami. Permintaan terkait data pribadi kami tanggapi paling lambat 3 x 24 jam.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={whatsapp(`Halo PosCare, saya ingin bertanya tentang ${title}: `)}
              rel="noopener"
              class="btn bg-white text-navy hover:bg-navy-50"
            >
              <MessageCircle size={18} aria-hidden="true" />
              WhatsApp {SITE.whatsappDisplay}
            </a>
            <a
              href={`mailto:${SITE.email}`}
              class="btn border border-white/25 text-white hover:border-white"
            >
              <Mail size={18} aria-hidden="true" />
              {SITE.email}
            </a>
          </div>
        </section>

        <a
          href="#main"
          class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-muted hover:text-ink"
        >
          <ArrowUp size={16} aria-hidden="true" />
          Kembali ke atas
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  // Highlight the section being read in the desktop table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [
      a.dataset.tocLink,
      a,
    ]),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('[data-legal-section]')];
  const setActive = (id: string) =>
    links.forEach((a, key) => a.toggleAttribute('data-active', key === id));
  const update = () => {
    let current = sections[0]?.id;
    for (const s of sections) if (s.getBoundingClientRect().top < 220) current = s.id;
    if (current) setActive(current);
  };
  if (links.size) {
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .legal-prose :global(p),
  .legal-prose :global(li) {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .legal-prose :global(p + p),
  .legal-prose :global(p + ul),
  .legal-prose :global(ul + p) {
    margin-top: 14px;
  }
  .legal-prose :global(ul) {
    padding-left: 0;
  }
  .legal-prose :global(li) {
    position: relative;
    padding-left: 22px;
  }
  .legal-prose :global(li)::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-border-strong);
  }
  .legal-prose :global(li + li) {
    margin-top: 8px;
  }
  .legal-prose :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .legal-prose :global(a) {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-orange);
    text-underline-offset: 3px;
  }
</style>
