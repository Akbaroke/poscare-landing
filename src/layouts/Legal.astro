---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { LEGAL_EFFECTIVE_DATE, type LegalSection } from '../data/legal';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  intro: string;
  sections: LegalSection[];
}
const { title, description, intro, sections } = Astro.props;

const effective = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
}).format(new Date(`${LEGAL_EFFECTIVE_DATE}T00:00:00+07:00`));
---

<Base title={title} description={description}>
  <Navbar />
  <main id="main" class="container-page max-w-3xl py-12 sm:py-16">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted hover:text-ink"
    >
      <ArrowLeft size={16} aria-hidden="true" />
      Kembali ke beranda
    </a>
    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mt-2 text-sm text-muted">
      Berlaku sejak <time datetime={LEGAL_EFFECTIVE_DATE}>{effective}</time>
    </p>
    <div class="legal-prose mt-6" set:html={intro} />

    <nav aria-labelledby="toc-title" class="card mt-8 p-5 sm:p-6">
      <h2 id="toc-title" class="text-sm font-bold">
        Daftar isi
      </h2>
      <ol class="mt-3 grid gap-x-6 gap-y-2 text-[15px] sm:grid-cols-2">
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} class="flex gap-2 text-muted hover:text-ink">
              <span class="w-5 shrink-0 text-subtle tabular-nums">{i + 1}.</span>
              {s.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="mt-10 space-y-10">
      {sections.map((s, i) => (
        <section id={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`} class="text-xl font-bold tracking-tight">
            <span class="mr-2 text-subtle tabular-nums">{i + 1}.</span>
            {s.title}
          </h2>
          <div class="legal-prose mt-3" set:html={s.html} />
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal-prose :global(p),
  .legal-prose :global(li) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .legal-prose :global(p + p),
  .legal-prose :global(p + ul),
  .legal-prose :global(ul + p) {
    margin-top: 12px;
  }
  .legal-prose :global(ul) {
    list-style: disc;
    padding-left: 22px;
  }
  .legal-prose :global(li + li) {
    margin-top: 6px;
  }
  .legal-prose :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .legal-prose :global(a) {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
